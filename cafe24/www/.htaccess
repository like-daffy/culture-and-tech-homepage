RewriteEngine On
RewriteBase /

# music.cafe24.com (the old profile site) moved to cultureand.tech. Every URL on that host answers 301 with its new
# address, in one hop; below /culture/, culture/.htaccess does this. robots.txt and Google/Naver verification files
# are still served, so crawlers can read the old URLs. See cafe24/README.md in the cultureand.tech repository.
RewriteCond %{HTTP_HOST} ^music\.cafe24\.com$ [NC]
RewriteRule ^(index\.html|promotion_kr\.html)?$ https://cultureand.tech/ko/ [R=301,L]

RewriteCond %{HTTP_HOST} ^music\.cafe24\.com$ [NC]
RewriteRule ^(index_en\.html|index_jp\.html)$ https://cultureand.tech/ [R=301,L]

RewriteCond %{HTTP_HOST} ^music\.cafe24\.com$ [NC]
RewriteRule ^sitemap\.xml$ https://cultureand.tech/sitemap.xml [R=301,L]

RewriteCond %{HTTP_HOST} ^music\.cafe24\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/(robots\.txt|(google|naver)[0-9a-zA-Z]+\.html)$
RewriteRule ^ https://cultureand.tech/ [R=301,L]

# Below: unchanged from the live file before this change (Cafe24 /www/.htaccess, 2026-10-22). Serves cultureand.tech
# from /culture/ when its DNS points back to Cafe24 for a rollback.

# 1. 루트에서 모든 접속을 HTTPS로 강제 리다이렉트
# 깨짐 방지를 위해 도메인을 직접 명시합니다.
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://cultureand.tech/$1 [R=301,L]

# 2. 접속 시 자동으로 /culture 폴더로 연결
RewriteCond %{HTTP_HOST} ^(www.)?cultureand.tech$ [NC]
RewriteCond %{REQUEST_URI} !^/culture/
RewriteRule ^(.*)$ culture/$1 [L]
