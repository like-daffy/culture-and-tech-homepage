{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": [
      "node scripts/check-checkout-config.mjs",
      "node scripts/check-clean-space-contract.mjs",
      "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-clean-space-config.mjs --deploy",
      "npm run build",
      "bash scripts/add-compat-assets.sh out",
      "bash scripts/sync-thai-legal.sh --check out/culture/thai-learn",
      "bash scripts/sync-mac-get-space-legal.sh --check out/culture/clean-space",
      "bash scripts/sync-english-thai-learn-legal.sh --check out/culture/english-thai-learn"
    ],
    "cleanUrls": false,
    "redirects": [
      { "source": "/culture", "destination": "/", "type": 301 },
      { "source": "/culture/", "destination": "/", "type": 301 },
      { "source": "/culture/index.html", "destination": "/", "type": 301 },
      { "source": "/apps/mac-get-space", "destination": "/apps/clean-space/", "type": 301 },
      { "source": "/apps/mac-get-space/", "destination": "/apps/clean-space/", "type": 301 },
      { "source": "/ko/apps/mac-get-space", "destination": "/ko/apps/clean-space/", "type": 301 },
      { "source": "/ko/apps/mac-get-space/", "destination": "/ko/apps/clean-space/", "type": 301 },
      { "source": "/culture/mac-get-space/:file", "destination": "/culture/clean-space/:file", "type": 301 },
      { "source": "/images/apps/mac-get-space/:file", "destination": "/images/apps/clean-space/:file", "type": 301 },
      { "source": "/apps/clean-space/account", "destination": "https://portal.cultureand.tech/products/clean-space", "type": 301 },
      { "source": "/apps/clean-space/account/", "destination": "https://portal.cultureand.tech/products/clean-space", "type": 301 },
      { "source": "/ko/apps/clean-space/account", "destination": "https://portal.cultureand.tech/ko/products/clean-space", "type": 301 },
      { "source": "/ko/apps/clean-space/account/", "destination": "https://portal.cultureand.tech/ko/products/clean-space", "type": 301 },
      { "source": "/apps/clean-space/activate", "destination": "https://portal.cultureand.tech/products/clean-space/activate", "type": 301 },
      { "source": "/apps/clean-space/activate/", "destination": "https://portal.cultureand.tech/products/clean-space/activate", "type": 301 },
      { "source": "/ko/apps/clean-space/activate", "destination": "https://portal.cultureand.tech/ko/products/clean-space/activate", "type": 301 },
      { "source": "/ko/apps/clean-space/activate/", "destination": "https://portal.cultureand.tech/ko/products/clean-space/activate", "type": 301 },
      { "source": "/apps/clean-space/auth/**", "destination": "https://portal.cultureand.tech/products/clean-space", "type": 301 },
      { "source": "/ko/apps/clean-space/auth/**", "destination": "https://portal.cultureand.tech/ko/products/clean-space", "type": 301 },
      { "source": "/apps/clean-space/account/index.html", "destination": "https://portal.cultureand.tech/products/clean-space", "type": 301 },
      { "source": "/ko/apps/clean-space/account/index.html", "destination": "https://portal.cultureand.tech/ko/products/clean-space", "type": 301 },
      { "source": "/apps/clean-space/activate/index.html", "destination": "https://portal.cultureand.tech/products/clean-space/activate", "type": 301 },
      { "source": "/ko/apps/clean-space/activate/index.html", "destination": "https://portal.cultureand.tech/ko/products/clean-space/activate", "type": 301 }
    ],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ] },
      { "source": "/", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ] },
      { "source": "/ko/", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ] },
      { "source": "/apps/**", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ] },
      { "source": "/ko/apps/**", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ] },
      { "source": "/checkout/**", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Referrer-Policy", "value": "strict-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ] },
      { "source": "/ko/checkout/**", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Referrer-Policy", "value": "strict-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ] },
      { "source": "**/*.html", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ] },
      { "source": "/_next/static/**", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ] },
      { "source": "/culture/_next/static/**", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ] },
      { "source": "/culture/**", "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ] },
      { "source": "/culture/**/*.html", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, must-revalidate" }
      ] },
      { "source": "/apps/clean-space/account/**", "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "strict-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://www.google.com/recaptcha/; frame-src https://*.firebaseapp.com https://*.web.app https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ] },
      { "source": "/apps/clean-space/auth/**", "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "strict-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://www.google.com/recaptcha/; frame-src https://*.firebaseapp.com https://*.web.app https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ] },
      { "source": "/apps/clean-space/activate/**", "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "strict-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://www.google.com/recaptcha/; frame-src https://*.firebaseapp.com https://*.web.app https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ] },
      { "source": "/ko/apps/clean-space/account/**", "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "strict-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://www.google.com/recaptcha/; frame-src https://*.firebaseapp.com https://*.web.app https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ] },
      { "source": "/ko/apps/clean-space/auth/**", "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "strict-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://www.google.com/recaptcha/; frame-src https://*.firebaseapp.com https://*.web.app https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ] },
      { "source": "/ko/apps/clean-space/activate/**", "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "strict-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://www.google.com/recaptcha/; frame-src https://*.firebaseapp.com https://*.web.app https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ] }
    ]
  }
}
