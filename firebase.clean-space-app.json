{
  "hosting": {
    "site": "clean-space-app",
    "public": "dist/clean-space-app",
    "ignore": ["firebase.json", "firebase.clean-space-app.json", "**/.*", "**/node_modules/**"],
    "predeploy": [
      "node scripts/build-clean-space-app.mjs"
    ],
    "cleanUrls": false,
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ] },
      { "source": "/", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ] },
      { "source": "/ko/", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ] },
      { "source": "**/*.html", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ] },
      { "source": "/_next/static/**", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ] }
    ]
  }
}
